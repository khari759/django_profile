# Build-time config for production builds (GitHub Pages).
#
# Tracked in git deliberately: Vite inlines VITE_* values into the public
# JavaScript bundle, so nothing here can be secret. Never put a key in this file.
#
# To point the site at a different API without a commit, set a
# VITE_API_BASE_URL repository variable — the deploy workflow writes it to
# .env.production.local, which Vite ranks above this file.

VITE_API_BASE_URL=https://portfolio-api-f06z.onrender.com
