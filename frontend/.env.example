# Copy to `.env.local` for local overrides, or set in your host's dashboard.
# Vite only exposes variables prefixed with VITE_.

# Base URL of the Django API (no trailing slash).
# Local default when unset: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production example:
# VITE_API_BASE_URL=https://portfolio-api.onrender.com
