# Copy to `.env` and adjust. Never commit the real `.env`.

# --- Core ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database -----------------------------------------------------------
# Omit for SQLite (default). For PostgreSQL:
# DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# --- Frontend origins ---------------------------------------------------
# Origins allowed to call the API from a browser (the Vite dev server, then
# your deployed frontend URL).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required in production when the admin is served over HTTPS:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# --- Contact form email -------------------------------------------------
# Leave CONTACT_NOTIFY_EMAIL empty to only store messages in the admin.
CONTACT_NOTIFY_EMAIL=
DJANGO_DEFAULT_FROM_EMAIL=portfolio@localhost
# Defaults to the console backend when DJANGO_DEBUG=True, SMTP otherwise.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=you@gmail.com
# DJANGO_EMAIL_PASSWORD=an-app-specific-password
# DJANGO_EMAIL_USE_TLS=True

# --- Production only ----------------------------------------------------
# Set False if TLS terminates at a proxy that already redirects.
# DJANGO_SECURE_SSL_REDIRECT=True
